@page
@model Web.Pages.Vehiculos.IndexModel
@{
}

<section class="page-section bg-light" id="vehiculos-index">
    <div class="container py-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <h1 class="fw-bold mb-1">Listado de vehículos</h1>
                <p class="text-muted mb-0">Consulta, administra y edita los vehículos registrados.</p>
            </div>

            <div>
                <a class="btn btn-primary px-4" asp-page="./Agregar">Agregar vehículo</a>
            </div>
        </div>

        @if (Model.vehiculos != null && Model.vehiculos.Any())
        {
            <div class="row g-4">
                @foreach (var vehiculo in Model.vehiculos)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card shadow-sm border-0 h-100 vehiculo-card">
                            <div class="card-body p-4">
                                <div class="mb-3">
                                    <h4 class="card-title fw-bold mb-1">@vehiculo.Marca @vehiculo.Modelo</h4>
                                    <p class="text-muted mb-0">Año: @vehiculo.Anio</p>
                                </div>

                                <div class="mb-4">
                                    <span class="badge bg-light text-dark border px-3 py-2">
                                        Placa: @vehiculo.Placa
                                    </span>
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <a class="btn btn-primary btn-sm"
                                       asp-page="./Detalle"
                                       asp-route-id="@vehiculo.Id">
                                        Detalle
                                    </a>

                                    <a class="btn btn-warning btn-sm text-dark"
                                       asp-page="./Editar"
                                       asp-route-id="@vehiculo.Id">
                                        Editar
                                    </a>

                                    <a class="btn btn-danger btn-sm"
                                       asp-page="./Eliminar"
                                       asp-route-id="@vehiculo.Id">
                                        Eliminar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info shadow-sm border-0 mt-4" role="alert">
                No hay vehículos registrados en este momento.
            </div>
        }
    </div>
</section>