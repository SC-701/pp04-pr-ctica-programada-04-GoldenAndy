@page
@model Web.Pages.Vehiculos.EliminarModel
@{
}

<section class="page-section bg-light" id="vehiculos-eliminar">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="bg-white shadow rounded-4 p-4 p-md-5">
                    <div class="mb-4 text-center">
                        <h1 class="fw-bold mb-2 text-danger">Eliminar vehículo</h1>
                        <p class="text-muted mb-0">Confirma si deseas eliminar este vehículo del sistema.</p>
                    </div>

                    <form method="post">
                        <div class="card border-0 shadow-sm vehiculo-eliminar-card">
                            <div class="card-body p-4">
                                <div class="mb-4">
                                    <h3 class="fw-bold mb-1">
                                        @Html.DisplayFor(modelo => modelo.vehiculo.Marca)
                                        @Html.DisplayFor(modelo => modelo.vehiculo.Modelo)
                                    </h3>
                                    <p class="text-muted mb-0">Revisa cuidadosamente la información antes de continuar.</p>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="detalle-item">
                                            <span class="detalle-label">@Html.DisplayNameFor(modelo => modelo.vehiculo.Placa)</span>
                                            <div class="detalle-value">@Html.DisplayFor(modelo => modelo.vehiculo.Placa)</div>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="detalle-item">
                                            <span class="detalle-label">@Html.DisplayNameFor(modelo => modelo.vehiculo.Anio)</span>
                                            <div class="detalle-value">@Html.DisplayFor(modelo => modelo.vehiculo.Anio)</div>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="detalle-item">
                                            <span class="detalle-label">@Html.DisplayNameFor(modelo => modelo.vehiculo.Precio)</span>
                                            <div class="detalle-value">@Html.DisplayFor(modelo => modelo.vehiculo.Precio)</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4">
                                    <div class="detalle-item">
                                        <span class="detalle-label">Propietario</span>
                                        <div class="detalle-value">
                                            @Html.DisplayFor(modelo => modelo.vehiculo.CorreoPropietario)
                                            <span class="mx-2 text-muted">|</span>
                                            @Html.DisplayFor(modelo => modelo.vehiculo.TelefonoPropietario)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning mt-4 mb-4 text-center" role="alert">
                            Esta acción no se puede deshacer.
                        </div>

                        <div class="d-flex flex-column flex-md-row gap-2 justify-content-center">
                            <a class="btn btn-outline-secondary px-4" asp-page="./Index">Regresar</a>
                            <button type="submit" class="btn btn-danger px-4">Eliminar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>