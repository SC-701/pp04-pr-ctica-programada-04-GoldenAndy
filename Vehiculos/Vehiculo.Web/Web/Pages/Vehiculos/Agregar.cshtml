@page
@model Web.Pages.Vehiculos.AgregarModel
@{
}

<section class="page-section bg-light" id="vehiculos-agregar">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="bg-white shadow rounded-4 p-4 p-md-5">
                    <div class="mb-4 text-center">
                        <h1 class="fw-bold mb-2">Agregar vehículo</h1>
                        <p class="text-muted mb-0">Complete la información para registrar un nuevo vehículo.</p>
                    </div>

                    <form method="post">
                        <div class="mb-3">
                            <label for="marcas" class="form-label fw-semibold">Marca</label>
                            <select id="marcas" asp-for="marcaSeleccionada" class="form-select"
                                    asp-items="Model.marcas" onchange="fectModelos()">
                                <option value="">Seleccione una marca</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="modelos" class="form-label fw-semibold">Modelo</label>
                            <select asp-for="vehiculo.IdModelo" class="form-select" asp-items="Model.modelos" id="modelos">
                                <option value="">Seleccione un modelo</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold" asp-for="vehiculo.Placa"></label>
                            <input class="form-control" asp-for="vehiculo.Placa" />
                            <span class="text-danger" asp-validation-for="vehiculo.Placa"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold" asp-for="vehiculo.Precio"></label>
                            <input class="form-control" asp-for="vehiculo.Precio" />
                            <span class="text-danger" asp-validation-for="vehiculo.Precio"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold" asp-for="vehiculo.Anio"></label>
                            <input class="form-control" asp-for="vehiculo.Anio" />
                            <span class="text-danger" asp-validation-for="vehiculo.Anio"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold" asp-for="vehiculo.Color"></label>
                            <input class="form-control" asp-for="vehiculo.Color" />
                            <span class="text-danger" asp-validation-for="vehiculo.Color"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold" asp-for="vehiculo.CorreoPropietario"></label>
                            <input class="form-control" asp-for="vehiculo.CorreoPropietario" />
                            <span class="text-danger" asp-validation-for="vehiculo.CorreoPropietario"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold" asp-for="vehiculo.TelefonoPropietario"></label>
                            <input class="form-control" asp-for="vehiculo.TelefonoPropietario" />
                            <span class="text-danger" asp-validation-for="vehiculo.TelefonoPropietario"></span>
                        </div>

                        <div class="d-flex flex-column flex-md-row gap-2 justify-content-center">
                            <a class="btn btn-outline-secondary px-4" asp-page="./Index">Regresar</a>
                            <button type="submit" class="btn btn-primary px-4">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        async function fectModelos() {
            const marcaId = document.getElementById("marcas").value;
            if (!marcaId) { return; }

            try {
                const respuesta = await fetch(`?handler=ObtenerModelos&marcaId=${marcaId}`);
                const modelos = await respuesta.json();
                const modelosSelect = document.getElementById("modelos");
                modelosSelect.innerHTML = '<option value="">Seleccione un modelo</option>';

                modelos.forEach(modelo => {
                    const option = document.createElement("option");
                    option.value = modelo.id;
                    option.text = modelo.nombre;
                    modelosSelect.appendChild(option);
                });
            } catch (error) {
                console.error('Error obteniendo los modelos', error);
            }
        }
    </script>
}